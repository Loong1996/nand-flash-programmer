// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) 引脚约束草案 —— 并口 NAND 原型接线
// 对应 docs/04-hardware-bringup.md 的接线表。接线前请对照官方原理图核对。
// 排针 J6/J7 均为 3.3V bank；不要使用 1.8V 的 Bank 3（LED/按键）。

// ---------------- 系统 ----------------
IO_LOC  "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 板载 USB 串口（BL702）
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------- NAND 数据总线 IO0-IO7 ----------------
IO_LOC  "nand_io[0]" 25;   // TSOP48 pin 29
IO_PORT "nand_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[1]" 26;   // TSOP48 pin 30
IO_PORT "nand_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[2]" 27;   // TSOP48 pin 31
IO_PORT "nand_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[3]" 28;   // TSOP48 pin 32
IO_PORT "nand_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[4]" 29;   // TSOP48 pin 41
IO_PORT "nand_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[5]" 30;   // TSOP48 pin 42
IO_PORT "nand_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[6]" 31;   // TSOP48 pin 43
IO_PORT "nand_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_io[7]" 32;   // TSOP48 pin 44
IO_PORT "nand_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------- NAND 控制信号 ----------------
IO_LOC  "nand_cle" 85;     // TSOP48 pin 16，空闲为低
IO_PORT "nand_cle" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "nand_ale" 84;     // TSOP48 pin 17，空闲为低
IO_PORT "nand_ale" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "nand_we_n" 83;    // TSOP48 pin 18
IO_PORT "nand_we_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_re_n" 82;    // TSOP48 pin 8
IO_PORT "nand_re_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_ce_n" 81;    // TSOP48 pin 9
IO_PORT "nand_ce_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "nand_wp_n" 80;    // TSOP48 pin 19，下拉 = 默认写保护
IO_PORT "nand_wp_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "nand_rb_n" 49;    // TSOP48 pin 7，开漏，必须上拉
IO_PORT "nand_rb_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
